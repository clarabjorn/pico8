pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init() 
 player={
 	x=0,
 	y=112,
 	dy=0,
 	s=1,
 	on_floor=true
 }
end

function _update()
 if btn(⬅️) then
  player.x -= 1
 elseif btn(➡️) then
  player.x += 1
 end
 
 map_check(player)
 
 if player.on_floor then
	 if btn(⬆️) then
 	 player.dy-=1
 	else
 		player.dy=0
 	end
 else
 	player.dy += 0.1
 end
 
 player.y+=player.dy

end

function _draw()
 cls(12)
 map()
 print(player.on_floor)
 spr(player.s, player.x, player.y )
 
end
-->8
--map collision
function hit_floor(o)
 local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 local s = mget(mx,my)
 if fget(s, 0) then
  return true
 end
 return false
end

function hit_coin(o)
 local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 local s = mget(mx,my)
 if fget(s, 1) then
  return true
 end
 return false
end

function map_check(o)
  o.on_floor = hit_floor(o)
  if hit_coin(o) then
  	collect_coin(o)
  end
end
-->8
--ting

function collect_coin(o)
	local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 mset(mx, my, 0)
end
