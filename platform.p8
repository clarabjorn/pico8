pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init() 
 player={
 	x=0,
 	y=112,
 	dy=0,
 	dx=0,
 	s=1,
 	on_floor=true,
  wall_right=false,
  wall_left=false,
 	h=7,
 	b=7,
 	max_speed_x = 2,
 	acc_x=0.25
 	
 }
 coins={}
 score=0
 
 init_coins()
end

function _update()
 if btn(⬅️) then
  player.dx -= player.acc_x
 elseif btn(➡️) then
  player.dx += player.acc_x
 else
  player.dx *= 0.9
 end
 player.dx = mid(
 			-player.max_speed_x,
 			player.dx,
 			player.max_speed_x
 ) 
 player.x += player.dx
 --map_check(player)
 
 if player.on_floor then
	 if btnp(⬆️) then
 	 player.dy-=4
 	else
 		player.dy=0
 		--player.y = flr (player.y/8)*8
 	end
 else
 	player.dy += 0.3
  end
  
 player.y+=player.dy
 map_check(player)
	if player.on_floor then 
		player.y = flr (player.y/8)*8
 end
 
 if player.dx < 0 then
  if player.wall_left then
   player.x = ceil(player.x/8)*8
  end
 else
  if player.wall_right then
   player.x = flr(player.x/8)*8
  end
 end
 update_coins()
end

function _draw()
 cls(12)
 map()
 print("score ".. score,8)
-- print(player.on_floor)
 draw_coins()
 spr(player.s, player.x, player.y )
 camera(max(player.x-40, 0),
 max(player.y-20, 0))
end
-->8
--map collision
function hit_floor(o)
 for a =0,8,4 do
  local mx = flr((o.x+a)/8)
  local my = flr((o.y+8)/8)
  local s = mget(mx,my)
  if fget(s, 0) then
   return true
  end
 end
 return false
end

function hit_wall(o)
 if o.dx <0 then
  for a =0,o.h,o.h do
   local mx = flr ((o.x)/8)
   local my = flr ((o.y+a)/8)
   local s = mget(mx,my)
   if fget(s, 0) then
    return true
   end
  end
  else
  for a =0,o.h,o.h do
   local mx = flr ((o.x+o.b)/8)
   local my = flr ((o.y+a)/8)
   local s = mget(mx,my)
   if fget(s, 0) then
    return true
   end
  end
  end
 return false
end

function hit_coin(o)
 local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 local s = mget(mx,my)
 if fget(s, 7) then
  return true
 end
 return false
end

function map_check(o) 
  player.on_floor = hit_floor(o)
  if o.dx <0 then
  o.wall_right=false
  o.wall_left=hit_wall(o)
  else
  o.wall_left=false
  o.wall_right=hit_wall(o)
  end
  if hit_coin(o) then
  	collect_coin(o)
  end
end
-->8
--coins
function init_coins()
 for x = 0,127 do
 	for y = 0,63 do
 		local s = mget( x,y)
 		if fget( s, 7) then
 			local coin={
 				x=x*8,
 				y=y*8,
 				h=7,
 				b=7
 				}
 			add(coins, coin)
 			mset(x,y,0)	
 			
			end
		end
 end
end

function update_coins()
 for c in all(coins) do
 	if collision(player,c) then
 		del(coins,c)
 		sfx(0)
 		score+=1
		end
 end
end

function draw_coins()
 for c in all (coins) do
  spr(5,c.x, c.y)
 end
end

















function collect_coin(o)
	local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 mset(mx, my, 0)
end
-->8
--collision
function collision(a,b)
	if b.x > a.x + a.b then
		return false
	elseif b.y >a.y+a.h then
	 return false
	elseif a.x>b.x+b.b then
  return false
 elseif a.y>b.y+b.h then
  return false
	end
	return true
end
