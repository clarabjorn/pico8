pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init() 
 player={
 	x=0,
 	y=112,
 	dy=0,
 	s=1,
 	on_floor=true,
 	h=7,
 	b=7
 }
 coins={}
 score=0
 
 init_coins()
end

function _update()
 if btn(⬅️) then
  player.x -= 1
 elseif btn(➡️) then
  player.x += 1
 end
 
 map_check(player)
 
 if player.on_floor then
	 if btnp(⬆️) then
 	 player.dy-=4
 	else
 		player.dy=0
 		player.y = flr (player.y/8)*8
 	end
 else
 	player.dy += 0.3
 end
 
 player.y+=player.dy
 update_coins()
end

function _draw()
 cls(12)
 map()
 print("score ".. score,8)
 print(player.on_floor)
 draw_coins()
 spr(player.s, player.x, player.y )
 
end
-->8
--map collision
function hit_floor(o)
 local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 local s = mget(mx,my)
 if fget(s, 0) then
  return true
 end
 return false
end

function hit_coin(o)
 local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 local s = mget(mx,my)
 if fget(s, 7) then
  return true
 end
 return false
end

function map_check(o)
  o.on_floor = hit_floor(o)
  if hit_coin(o) then
  	collect_coin(o)
  end
end
-->8
--coins
function init_coins()
 for x = 0,127 do
 	for y = 0,63 do
 		local s = mget( x,y)
 		if fget( s, 7) then
 			local coin={
 				x=x*8,
 				y=y*8,
 				h=7,
 				b=7
 				}
 			add(coins, coin)
 			mset(x,y,0)	
 			
			end
		end
 end
end

function update_coins()
 for c in all(coins) do
 	if collision(player,c) then
 		del(coins,c)
 		sfx(0)
 		score+=1
		end
 end
end

function draw_coins()
 for c in all (coins) do
  spr(5,c.x, c.y)
 end
end

















function collect_coin(o)
	local mx = flr(o.x/8)
 local my = flr((o.y+8)/8)
 mset(mx, my, 0)
end
-->8
--collision
function collision(a,b)
	if b.x > a.x + a.b then
		return false
	elseif b.y >a.y+a.h then
	 return false
	elseif a.x>b.x+b.b then
  return false
 elseif a.y>b.y+b.h then
  return false
	end
	return true
end
